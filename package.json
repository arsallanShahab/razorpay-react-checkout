{
  "name": "razorpay-react-checkout",
  "version": "1.3.0",
  "description": "TypeScript-first, SSR-safe React SDK for Razorpay with hooks, Next.js support, and seamless integration for modern web applications. Designed for developers seeking simplicity and performance.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.mjs",
      "require": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\" \"test/**/*.ts\" \"test/**/*.tsx\"",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "npm run build && npm run test && npm run lint",
    "precommit": "lint-staged",
    "release": "standard-version"
  },
  "keywords": [
    "razorpay",
    "react",
    "sdk",
    "hooks",
    "ssr",
    "nextjs",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsallanShahab/razorpay-react-checkout.git"
  },
  "author": {
    "name": "Arsallan Shahab",
    "url": "https://github.com/arsallanShahab"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/arsallanShahab/razorpay-react-checkout/issues"
  },
  "homepage": "https://github.com/arsallanShahab/razorpay-react-checkout#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.0",
    "jsdom": "^22.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "standard-version": "^9.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "contributors": [
    {
      "name": "Arsallan Shahab",
      "email": "marsallan@proton.me",
      "url": "https://github.com/arsallanShahab"
    }
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  }
}
